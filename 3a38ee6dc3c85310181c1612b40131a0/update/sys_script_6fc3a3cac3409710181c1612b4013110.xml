        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var assetSysId = current.getValue('u_impacted_asset') || current.getValue('x_2240997_smarti_0_impacted_asset');

    if (!assetSysId) {
        return;
    }

    // 1. Retire the damaged physical asset
    var grAsset = new GlideRecord('x_2240997_smarti_0_it_asset');
    if (grAsset.get(assetSysId)) {
        grAsset.setValue('status', 'retired');
        grAsset.setValue('condition', 'damaged');
        grAsset.setValue('retired_date', new GlideDate());
        grAsset.update();

        // 2. Automatically spawn a replacement hardware request
        var grReq = new GlideRecord('x_2240997_smarti_0_hardware_request');
        grReq.initialize();
        grReq.setValue('requested_for', current.getValue('caller_id'));
        grReq.setValue('device_type', grAsset.getValue('device_type'));
        grReq.setValue('short_description', 'Auto-replacement for damaged asset: ' + grAsset.getValue('asset_tag'));
        grReq.insert();
    }

})(current, previous);]]></script>
